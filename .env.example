# Server
PORT=3001
JWT_SECRET=change-this-to-a-random-secret-key
AMAP_KEY=your-amap-web-service-api-key

# Client (Vite — needed at build time on Render)
VITE_AMAP_KEY=your-amap-js-api-key
VITE_AMAP_SECURITY_CODE=your-amap-security-code

# Render (optional — attach a persistent disk at /var/data on paid plans)
# DATA_DIR=/var/data

# Vercel — set these in Project Settings → Environment Variables
# JWT_SECRET, AMAP_KEY, VITE_AMAP_KEY, VITE_AMAP_SECURITY_CODE
