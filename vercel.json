{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/server.ts": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "node_modules/sql.js/**"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/server" },
    { "src": "/uploads/(.*)", "dest": "/api/server" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
